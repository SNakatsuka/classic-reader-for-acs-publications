{
  "manifest_version": 3,
  "name": "ACS Classic 2008 Mode",
  "version": "0.8.2",
  "description": "ACS 論文ページを、読みやすいクラシック表示に整えます。",
  "permissions": ["storage"],
  "action": { "default_title": "ACS Classic 2008 Mode", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://pubs.acs.org/*"],
    "js": ["content.js"],
    "css": ["classic.css"],
    "run_at": "document_idle"
  }]
}
